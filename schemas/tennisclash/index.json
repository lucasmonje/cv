{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index.json",
  "title": "TennisClash Schemas Index",
  "description": "Index of all available TennisClash schemas",
  "type": "object",
  "properties": {
    "base": {
      "$ref": "./base.json"
    },
    "rewards": {
      "$ref": "./rewards.json"
    },
    "types": {
      "type": "object",
      "description": "Individual reward type schemas",
      "properties": {
        "soft": {
          "$ref": "./types/soft.json"
        },
        "hard": {
          "$ref": "./types/hard.json"
        },
        "energy": {
          "$ref": "./types/energy.json"
        },
        "clanTickets": {
          "$ref": "./types/clanTickets.json"
        },
        "chest": {
          "$ref": "./types/chest.json"
        },
        "character": {
          "$ref": "./types/character.json"
        },
        "item": {
          "$ref": "./types/item.json"
        },
        "skin": {
          "$ref": "./types/skin.json"
        },
        "sticker": {
          "$ref": "./types/sticker.json"
        },
        "pack": {
          "$ref": "./types/pack.json"
        }
      }
    }
  }
}