{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tennisclash/rewards.json",
  "title": "TennisClash Rewards Schema",
  "description": "Schema for validating TennisClash reward configurations",
  "type": "object",
  "properties": {
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "if": {
              "properties": {
                "category": { "const": "soft" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/soft.json" }
          },
          {
            "if": {
              "properties": {
                "category": { "const": "hard" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/hard.json" }
          },
          {
            "if": {
              "properties": {
                "category": { "const": "energy" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/energy.json" }
          },
          {
            "if": {
              "properties": {
                "category": { "const": "clanTickets" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/clanTickets.json" }
          },
          {
            "if": {
              "properties": {
                "category": { "const": "chest" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/chest.json" }
          },
          {
            "if": {
              "properties": {
                "category": { "const": "character" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/character.json" }
          },
          {
            "if": {
              "properties": {
                "category": { "const": "item" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/item.json" }
          },
          {
            "if": {
              "properties": {
                "category": { "const": "skin" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/skin.json" }
          },
          {
            "if": {
              "properties": {
                "category": { "const": "sticker" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/sticker.json" }
          },
          {
            "if": {
              "properties": {
                "category": { "const": "pack" }
              },
              "required": ["category"]
            },
            "then": { "$ref": "tennisclash/types/pack.json" }
          }
        ]
      },
      "description": "Array of reward configurations"
    }
  },
  "required": [
    "rewards"
  ],
  "additionalProperties": false
}