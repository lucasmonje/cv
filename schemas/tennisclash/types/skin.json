{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skin.json",
  "title": "Skin Reward Schema",
  "description": "Schema for skin rewards",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "const": "skin",
      "description": "Reward category: Skin"
    },
    "type": {
      "type": "string",
      "enum": [
        "0",
        "1"
      ],
      "title": "Type",
      "description": "Available type options"
    }
  },
  "required": [
    "category",
    "type"
  ],
  "additionalProperties": false
}