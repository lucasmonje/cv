{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tennisclash/types/item.json",
  "title": "Item Reward Schema",
  "description": "Schema for item rewards",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "const": "item",
      "description": "Reward category: Item"
    },
    "character": {
      "type": "string",
      "enum": [
        "alpaca",
        "bat",
        "beaver",
        "bee",
        "bluemacaw",
        "buffalo",
        "capybara",
        "cat",
        "chameleon",
        "crab",
        "crocodile",
        "eagle",
        "echidna",
        "elephant",
        "flamingo",
        "frog",
        "giraffe",
        "gorilla",
        "hippo",
        "kangaroo",
        "koala",
        "komodo",
        "lion",
        "octopus",
        "orca",
        "panda",
        "panther",
        "peacock",
        "penguin",
        "rabbit",
        "raccoon",
        "rat",
        "reindeer",
        "rhino",
        "salamander",
        "shark",
        "snake",
        "tiger",
        "turtle",
        "wolf",
        "zebra",
        "ladybug",
        "lemur",
        "owl",
        "polarbear",
        ""
      ],
      "title": "Character",
      "description": "Available character options"
    },
    "type": {
      "type": "string",
      "enum": [
        "aid_kit_area_heal",
        "begin_match_bonus",
        "bomb_fire_area",
        "bush_exit_speed",
        "cluster_bomb",
        "force_laugh_emote",
        "guard_charm",
        "heal_by_damage",
        "hp_recover_stand",
        "infrared_binoculars",
        "instant_revive",
        "kill_boost",
        "life_steal",
        "push_to_self_pheromone",
        "redzone_invuln_time",
        "revive_on_death",
        "sharp_scythe",
        "special_knockback",
        "tools_kit",
        "turbo_rockets",
        "use_kit_before_die",
        "walk_on_water",
        "walk_under_water",
        "electric_gauntlets",
        "gummy_vitamins",
        ""
      ],
      "title": "Type",
      "description": "Available type options"
    },
    "amount": {
      "$ref": "tennisclash/base.json#amount"
    }
