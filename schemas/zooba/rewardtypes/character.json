{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wls.com/schemas/zooba/rewardtypes/character.json",
  "title": "Character Reward Schema",
  "description": "Schema for character rewards",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "const": "character",
      "description": "Reward category: Character"
    },
    "type": {
      "type": "string",
      "enum": [
        "alpaca",
        "bat",
        "beaver",
        "bee",
        "bluemacaw",
        "buffalo",
        "capybara",
        "cat",
        "chameleon",
        "crab",
        "crocodile",
        "eagle",
        "echidna",
        "elephant",
        "flamingo",
        "frog",
        "giraffe",
        "gorilla",
        "hippo",
        "kangaroo",
        "koala",
        "komodo",
        "lion",
        "octopus",
        "orca",
        "panda",
        "panther",
        "peacock",
        "penguin",
        "rabbit",
        "raccoon",
        "rat",
        "reindeer",
        "rhino",
        "salamander",
        "shark",
        "snake",
        "tiger",
        "turtle",
        "wolf",
        "zebra",
        "ladybug",
        "lemur",
        "owl",
        "polarbear"
      ],
      "title": "Type",
      "description": "Character type"
    },
    "amount": {
      "$anchor": "amount",
      "type": "number",
      "minimum": 0,
      "description": "Quantity or amount of the reward"
    }
  },
  "required": [
    "category",
    "type",
    "amount"
  ],
  "unevaluatedProperties": false,
  "$defs": {}
}