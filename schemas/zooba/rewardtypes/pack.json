{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wls.com/schemas/zooba/rewardtypes/pack.json",
  "title": "Liveops Packs Reward Schema",
  "description": "Schema for liveops packs rewards",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "const": "pack",
      "description": "Reward category: Pack"
    },
    "amount": {
      "$anchor": "amount",
      "type": "number",
      "minimum": 0,
      "description": "Quantity or amount of the reward"
    },
    "textField": {
      "$anchor": "non-empty-string",
      "type": "string",
      "minLength": 1,
      "description": "String that must not be empty"
    }
  },
  "required": [
    "category",
    "amount",
    "textField"
  ],
  "unevaluatedProperties": false,
  "$defs": {}
}